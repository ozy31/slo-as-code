# Generated by slogen from examples/batch-ingest.yaml. Do not edit.
groups:
  - name: slo:batch-ingest:freshness:recording
    interval: 30s
    rules:
      - record: slo:sli_error:ratio_rate5m
        expr: |-
          (sum(increase(ingest_runs_total{result="failed"}[5m])))
          /
          (sum(increase(ingest_runs_total[5m])))
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:sli_error:ratio_rate30m
        expr: |-
          (sum(increase(ingest_runs_total{result="failed"}[30m])))
          /
          (sum(increase(ingest_runs_total[30m])))
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:sli_error:ratio_rate1h
        expr: |-
          (sum(increase(ingest_runs_total{result="failed"}[1h])))
          /
          (sum(increase(ingest_runs_total[1h])))
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:sli_error:ratio_rate2h
        expr: |-
          (sum(increase(ingest_runs_total{result="failed"}[2h])))
          /
          (sum(increase(ingest_runs_total[2h])))
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:sli_error:ratio_rate6h
        expr: |-
          (sum(increase(ingest_runs_total{result="failed"}[6h])))
          /
          (sum(increase(ingest_runs_total[6h])))
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:sli_error:ratio_rate1d
        expr: |-
          (sum(increase(ingest_runs_total{result="failed"}[1d])))
          /
          (sum(increase(ingest_runs_total[1d])))
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:sli_error:ratio_rate3d
        expr: |-
          (sum(increase(ingest_runs_total{result="failed"}[3d])))
          /
          (sum(increase(ingest_runs_total[3d])))
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:sli_error:ratio_rate28d
        expr: |-
          (sum(increase(ingest_runs_total{result="failed"}[28d])))
          /
          (sum(increase(ingest_runs_total[28d])))
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:objective:ratio
        expr: "0.995"
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:error_budget:ratio
        expr: "0.005"
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:burn_rate:5m
        expr: slo:sli_error:ratio_rate5m{service="batch-ingest", slo="freshness"} / 0.005
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:burn_rate:30m
        expr: slo:sli_error:ratio_rate30m{service="batch-ingest", slo="freshness"} / 0.005
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:burn_rate:1h
        expr: slo:sli_error:ratio_rate1h{service="batch-ingest", slo="freshness"} / 0.005
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:burn_rate:2h
        expr: slo:sli_error:ratio_rate2h{service="batch-ingest", slo="freshness"} / 0.005
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:burn_rate:6h
        expr: slo:sli_error:ratio_rate6h{service="batch-ingest", slo="freshness"} / 0.005
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:burn_rate:1d
        expr: slo:sli_error:ratio_rate1d{service="batch-ingest", slo="freshness"} / 0.005
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:burn_rate:3d
        expr: slo:sli_error:ratio_rate3d{service="batch-ingest", slo="freshness"} / 0.005
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:burn_rate:28d
        expr: slo:sli_error:ratio_rate28d{service="batch-ingest", slo="freshness"} / 0.005
        labels:
          service: batch-ingest
          slo: freshness
          team: data
      - record: slo:error_budget_remaining:ratio
        expr: 1 - (slo:sli_error:ratio_rate28d{service="batch-ingest", slo="freshness"} / 0.005)
        labels:
          service: batch-ingest
          slo: freshness
          team: data
  - name: slo:batch-ingest:freshness:alerts
    rules:
      - alert: BatchIngestFreshnessBudgetBurnTicket
        expr: |-
          (
            slo:sli_error:ratio_rate1d{service="batch-ingest", slo="freshness"} > 0.014
            and
            slo:sli_error:ratio_rate2h{service="batch-ingest", slo="freshness"} > 0.014
          )
          or
          (
            slo:sli_error:ratio_rate3d{service="batch-ingest", slo="freshness"} > 0.004667
            and
            slo:sli_error:ratio_rate6h{service="batch-ingest", slo="freshness"} > 0.004667
          )
        for: 1h
        labels:
          service: batch-ingest
          severity: warning
          slo: freshness
          slo_alert: ticket
          team: data
        annotations:
          description: 'Objective 99.5% over 28d. Fires on burn rates of 2.8x over 1d/2h, 0.9333x over 3d/6h, error ratio over the long window: {{ $value | humanizePercentage }}.'
          summary: batch-ingest freshness SLO is burning its error budget too fast
