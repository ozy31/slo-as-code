# Generated by slogen from examples/checkout.yaml. Do not edit.
groups:
  - name: slo:checkout:availability:recording
    interval: 30s
    rules:
      - record: slo:sli_error:ratio_rate5m
        expr: |-
          (sum(rate(http_requests_total{job="checkout", code=~"5.."}[5m])))
          /
          (sum(rate(http_requests_total{job="checkout"}[5m])))
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:sli_error:ratio_rate30m
        expr: |-
          (sum(rate(http_requests_total{job="checkout", code=~"5.."}[30m])))
          /
          (sum(rate(http_requests_total{job="checkout"}[30m])))
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:sli_error:ratio_rate1h
        expr: |-
          (sum(rate(http_requests_total{job="checkout", code=~"5.."}[1h])))
          /
          (sum(rate(http_requests_total{job="checkout"}[1h])))
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:sli_error:ratio_rate2h
        expr: |-
          (sum(rate(http_requests_total{job="checkout", code=~"5.."}[2h])))
          /
          (sum(rate(http_requests_total{job="checkout"}[2h])))
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:sli_error:ratio_rate6h
        expr: |-
          (sum(rate(http_requests_total{job="checkout", code=~"5.."}[6h])))
          /
          (sum(rate(http_requests_total{job="checkout"}[6h])))
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:sli_error:ratio_rate1d
        expr: |-
          (sum(rate(http_requests_total{job="checkout", code=~"5.."}[1d])))
          /
          (sum(rate(http_requests_total{job="checkout"}[1d])))
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:sli_error:ratio_rate3d
        expr: |-
          (sum(rate(http_requests_total{job="checkout", code=~"5.."}[3d])))
          /
          (sum(rate(http_requests_total{job="checkout"}[3d])))
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:sli_error:ratio_rate30d
        expr: |-
          (sum(rate(http_requests_total{job="checkout", code=~"5.."}[30d])))
          /
          (sum(rate(http_requests_total{job="checkout"}[30d])))
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:objective:ratio
        expr: "0.999"
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:error_budget:ratio
        expr: "0.001"
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:burn_rate:5m
        expr: slo:sli_error:ratio_rate5m{service="checkout", slo="availability"} / 0.001
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:burn_rate:30m
        expr: slo:sli_error:ratio_rate30m{service="checkout", slo="availability"} / 0.001
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:burn_rate:1h
        expr: slo:sli_error:ratio_rate1h{service="checkout", slo="availability"} / 0.001
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:burn_rate:2h
        expr: slo:sli_error:ratio_rate2h{service="checkout", slo="availability"} / 0.001
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:burn_rate:6h
        expr: slo:sli_error:ratio_rate6h{service="checkout", slo="availability"} / 0.001
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:burn_rate:1d
        expr: slo:sli_error:ratio_rate1d{service="checkout", slo="availability"} / 0.001
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:burn_rate:3d
        expr: slo:sli_error:ratio_rate3d{service="checkout", slo="availability"} / 0.001
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:burn_rate:30d
        expr: slo:sli_error:ratio_rate30d{service="checkout", slo="availability"} / 0.001
        labels:
          service: checkout
          slo: availability
          team: payments
      - record: slo:error_budget_remaining:ratio
        expr: 1 - (slo:sli_error:ratio_rate30d{service="checkout", slo="availability"} / 0.001)
        labels:
          service: checkout
          slo: availability
          team: payments
  - name: slo:checkout:availability:alerts
    rules:
      - alert: CheckoutAvailabilityBudgetBurnPage
        expr: |-
          (
            slo:sli_error:ratio_rate1h{service="checkout", slo="availability"} > 0.0144
            and
            slo:sli_error:ratio_rate5m{service="checkout", slo="availability"} > 0.0144
          )
          or
          (
            slo:sli_error:ratio_rate6h{service="checkout", slo="availability"} > 0.006
            and
            slo:sli_error:ratio_rate30m{service="checkout", slo="availability"} > 0.006
          )
        for: 2m
        labels:
          service: checkout
          severity: critical
          slo: availability
          slo_alert: page
          team: payments
        annotations:
          description: 'Objective 99.9% over 30d. Fires on burn rates of 14.4x over 1h/5m, 6x over 6h/30m, error ratio over the long window: {{ $value | humanizePercentage }}.'
          runbook_url: https://github.com/ozy31/slo-as-code/blob/main/docs/runbooks/burn-rate.md
          summary: checkout availability SLO is burning its error budget too fast
      - alert: CheckoutAvailabilityBudgetBurnTicket
        expr: |-
          (
            slo:sli_error:ratio_rate1d{service="checkout", slo="availability"} > 0.003
            and
            slo:sli_error:ratio_rate2h{service="checkout", slo="availability"} > 0.003
          )
          or
          (
            slo:sli_error:ratio_rate3d{service="checkout", slo="availability"} > 0.001
            and
            slo:sli_error:ratio_rate6h{service="checkout", slo="availability"} > 0.001
          )
        for: 1h
        labels:
          service: checkout
          severity: warning
          slo: availability
          slo_alert: ticket
          team: payments
        annotations:
          description: 'Objective 99.9% over 30d. Fires on burn rates of 3x over 1d/2h, 1x over 3d/6h, error ratio over the long window: {{ $value | humanizePercentage }}.'
          runbook_url: https://github.com/ozy31/slo-as-code/blob/main/docs/runbooks/burn-rate.md
          summary: checkout availability SLO is burning its error budget too fast
      - alert: CheckoutAvailabilityErrorBudgetExhausted
        expr: slo:error_budget_remaining:ratio{service="checkout", slo="availability"} < 0
        for: 15m
        labels:
          service: checkout
          severity: warning
          slo: availability
          slo_alert: exhausted
          team: payments
        annotations:
          description: 'Objective 99.9% over 30d is missed: {{ $value | humanizePercentage }} of the budget remains. Prioritise reliability work over new releases until it recovers.'
          runbook_url: https://github.com/ozy31/slo-as-code/blob/main/docs/runbooks/burn-rate.md
          summary: checkout availability SLO has spent its whole error budget
  - name: slo:checkout:latency:recording
    interval: 30s
    rules:
      - record: slo:sli_error:ratio_rate5m
        expr: |-
          (sum(rate(http_request_duration_seconds_count{job="checkout"}[5m])) - sum(rate(http_request_duration_seconds_bucket{job="checkout", le="0.3"}[5m])))
          /
          (sum(rate(http_request_duration_seconds_count{job="checkout"}[5m])))
        labels:
          service: checkout
